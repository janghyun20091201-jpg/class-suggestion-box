# ─────────────────────────────────────────────────────────────
#  Supabase
#  Project Settings → API 에서 값을 복사하세요.
# ─────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL (예: https://abcdxyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# 서버 전용 Service Role 키 (절대 클라이언트에 노출 금지)
# Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# 첨부파일을 저장할 Storage 버킷 이름 (기본값: attachments)
SUPABASE_STORAGE_BUCKET=attachments

# ─────────────────────────────────────────────────────────────
#  관리자 로그인
# ─────────────────────────────────────────────────────────────

# /admin 페이지 접속 비밀번호
ADMIN_PASSWORD=change-this-password

# 로그인 세션 쿠키 서명용 임의 문자열 (긴 무작위 값 권장)
SESSION_SECRET=please-change-to-a-long-random-string
