# ─────────────────────────────────────────────────────────────
#  Supabase  (Project Settings → API 에서 복사)
# ─────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL (예: https://abcdxyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# 서버 전용 Secret(service_role) 키 — 절대 공개 금지
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
#  관리자 로그인
# ─────────────────────────────────────────────────────────────

# /admin 페이지 접속 비밀번호
ADMIN_PASSWORD=admin2105

# 로그인 세션 쿠키 서명용 임의 문자열 (긴 무작위 값 권장)
SESSION_SECRET=please-change-to-a-long-random-string
